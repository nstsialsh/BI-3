def is_inside_simple(A, B, C, P, epsilon=1e-10):
    x1, y1 = A
    x2, y2 = B
    x3, y3 = C
    x, y = P

    area1 = (x*(y2-y3) + x2*(y3-y) + x3*(y-y2)) / 2
    area2 = (x1*(y-y3) + x*(y3-y1) + x3*(y1-y)) / 2  
    area3 = (x1*(y2-y) + x2*(y-y1) + x*(y1-y2)) / 2
    area_main = (x1*(y2-y3) + x2*(y3-y1) + x3*(y1-y2)) / 2
    
    return abs(abs(area1) + abs(area2) + abs(area3) - abs(area_main)) < epsilon

A = (0, 2)
B = (5, 0)
C = (1, 3)
P = (1, -1)

result = is_inside_simple(A, B, C, P)
print(f"Точка {P} внутри треугольника: {result}")
