from itertools import permutations

def solve_cryptarithmetic():
  
    print("  DONALD")
    print("+ GERALD")
    print("--------")
    print(" ROBERT")
    print("Условие: D = 5")
    
    letters = "DONALGERBT"
    
    fixed = {'D': 5}

    remaining_letters = [letter for letter in letters if letter not in fixed]
    
    available_digits = [d for d in range(10) if d != 5]
    
    checked = 0

for perm in permutations(available_digits, len(remaining_letters)):
        checked += 1
        
        mapping = fixed.copy()
        mapping.update(zip(remaining_letters, perm))
        
        if len(set(mapping.values())) != len(mapping.values()):
            continue
            
        if mapping['G'] == 0 or mapping['R'] == 0:
            continue
