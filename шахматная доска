import numpy as np

M1 = np.tile(np.array([[-1, 1], [1, -1]]), (4, 4))
print("M1 (цвета клеток):")
print(M1)

M2 = np.random.randint(-1, 2, (8, 8))
print("\nM2 (фигуры):")
print(M2)

X1 = 0  # количество белых фигур на чёрных полях
X2 = 0  # количество чёрных фигур на белых полях
X3 = 0  # количество фигур на своих полях

for i in range(8):
    for j in range(8):
        if M2[i, j] == 0:
            continue
        product = M1[i, j] * M2[i, j]
        if product == 1:
            X3 += 1
        elif product == -1:
            if M2[i, j] == 1:
                X1 += 1
            else:  # M2[i, j] == -1
                X2 += 1
print(f"\nX1 (белые на чёрных) = {X1}")
print(f"X2 (чёрные на белых) = {X2}")
print(f"X3 (на своих полях) = {X3}")
